+++ b/app/src/main/java/org/openclone/app/clone/DexComponentScanner.kt
@@ -0,0 +1,107 @@
+package org.openclone.app.clone
+
+import java.io.File
+import java.util.zip.ZipFile
+import org.jf.dexlib2.DexFileFactory
+import org.jf.dexlib2.Opcodes
+import org.jf.dexlib2.iface.instruction.ReferenceInstruction
+import org.jf.dexlib2.iface.reference.MethodReference
+import org.jf.dexlib2.iface.reference.StringReference
+
+/**
+ * Diagnostic scan of how an app's DEX files refer to its own package, so a build can be checked
+ * against the real app instead of guessed at. It reads only; it changes nothing.
+ *
+ * It is a per-method heuristic, not data-flow analysis: a literal and a component API that sit in
+ * the same method are reported together. Treat DYNAMIC as "look at this method by hand".
+ */
+object DexComponentScanner {
+    enum class Shape {
+        /** One flattened string such as "pkg/.Class" or "pkg/pkg.Class". */
+        FLATTENED,
+        /** The package alone and a package-qualified class name as two literals. */
+        SEPARATE_LITERALS,
+        /** The package alone, with a relative fragment ("/.X", ".X") or string building in the method. */
+        DYNAMIC,
+        /** The package alone, used with no class literal beside it. */
+        PACKAGE_ONLY
+    }
+
+    data class Finding(
+        val method: String,
+        val shape: Shape,
+        val literals: List<String>,
+        val componentApis: List<String>
+    )
+
+    private val COMPONENT_APIS = setOf(
+        "ComponentName-><init>", "Intent->setClassName", "Intent->setComponent", "Intent->setPackage",
+        "Intent-><init>", "PackageManager->getLaunchIntentForPackage", "ComponentName->unflattenFromString",
+        "Intent->parseUri", "Class->forName", "PendingIntent->getActivity"
+    )
+    private val STRING_BUILDING = setOf("StringBuilder->append", "String->concat", "String->format", "String->valueOf")
+
+    fun scanApk(apk: File, oldPackage: String): List<Finding> {
+        val results = mutableListOf<Finding>()
+        val temp = File.createTempFile("openclone-scan-", ".dex")
+        try {
+            ZipFile(apk).use { zip ->
+                for (entry in zip.entries().asSequence().filter { it.name.matches(Regex("classes\\d*\\.dex")) }) {
+                    zip.getInputStream(entry).use { input -> temp.outputStream().use { input.copyTo(it) } }
+                    results += scan(temp, oldPackage).map { it.copy(method = "${entry.name}:${it.method}") }
+                }
+            }
+        } finally {
+            temp.delete()
+        }
+        return results
+    }
+
+    fun scan(dexFile: File, oldPackage: String): List<Finding> {
+        val dex = DexFileFactory.loadDexFile(dexFile, Opcodes.getDefault())
+        val findings = mutableListOf<Finding>()
+        for (classDef in dex.classes) {
+            for (method in classDef.methods) {
+                val instructions = method.implementation?.instructions ?: continue
+                val literals = mutableListOf<String>()
+                val apis = linkedSetOf<String>()
+                for (instruction in instructions) {
+                    val reference = (instruction as? ReferenceInstruction)?.reference
+                    when (reference) {
+                        is StringReference -> literals += reference.string
+                        is MethodReference -> apis += reference.definingClass.substringAfterLast('/').trimEnd(';') +
+                            "->" + reference.name
+                    }
+                }
+                val mine = literals.filter {
+                    it == oldPackage || it.startsWith("$oldPackage/") || it.startsWith("$oldPackage.") ||
+                        it.startsWith("/.") || (it.startsWith(".") && it.length > 1)
+                }
+                if (mine.none { it == oldPackage || it.startsWith("$oldPackage/") }) continue
+                val componentApis = apis.filter { it in COMPONENT_APIS }
+                val building = apis.any { it in STRING_BUILDING }
+                val shape = when {
+                    mine.any { it.startsWith("$oldPackage/") } -> Shape.FLATTENED
+                    mine.any { it.startsWith("/.") || it.startsWith(".") } || building -> Shape.DYNAMIC
+                    mine.any { it.startsWith("$oldPackage.") } -> Shape.SEPARATE_LITERALS
+                    else -> Shape.PACKAGE_ONLY
+                }
+                findings += Finding("${classDef.type}->${method.name}", shape, mine.distinct(), componentApis + apis.filter { it in STRING_BUILDING })
+            }
+        }
+        return findings
+    }
+
+    /** Command line: DexComponentScanner app.apk com.example.app */
+    @JvmStatic
+    fun main(args: Array<String>) {
+        require(args.size == 2) { "usage: DexComponentScanner <apk-or-dex> <original-package>" }
+        val file = File(args[0])
+        val findings = if (file.name.endsWith(".dex")) scan(file, args[1]) else scanApk(file, args[1])
+        findings.groupBy { it.shape }.forEach { (shape, items) ->
+            println("== $shape (${items.size})")
+            items.forEach { println("  ${it.method}\n    literals=${it.literals}\n    apis=${it.componentApis}") }
+        }
+        if (findings.isEmpty()) println("No method pairs the package literal with a component API.")
+    }
+}
