@@ -0,0 +1,195 @@
+package org.openclone.app.clone
+
+import java.io.File
+import java.nio.file.Files
+import org.jf.dexlib2.AccessFlags
+import org.jf.dexlib2.DexFileFactory
+import org.jf.dexlib2.Opcode
+import org.jf.dexlib2.Opcodes
+import org.jf.dexlib2.builder.MutableMethodImplementation
+import org.jf.dexlib2.builder.instruction.BuilderInstruction10x
+import org.jf.dexlib2.builder.instruction.BuilderInstruction21c
+import org.jf.dexlib2.builder.instruction.BuilderInstruction35c
+import org.jf.dexlib2.iface.instruction.ReferenceInstruction
+import org.jf.dexlib2.iface.reference.StringReference
+import org.jf.dexlib2.immutable.reference.ImmutableMethodReference
+import org.jf.dexlib2.immutable.value.ImmutableStringEncodedValue
+import org.jf.dexlib2.writer.builder.BuilderField
+import org.jf.dexlib2.writer.builder.BuilderMethod
+import org.jf.dexlib2.writer.builder.DexBuilder
+import org.jf.dexlib2.writer.io.FileDataStore
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+/**
+ * Runs the rewriter over real DEX files built here, so what is checked is the instruction and
+ * encoded-value rewriting, not just the string helper. A passing run still does not show that a
+ * given app works: that needs the real app's DEX (see DexComponentScanner) and a device.
+ */
+class DexPackageStringRewriterDexTest {
+    private val old = "com.whatsapp"
+    private val clone = "com.whatsapp.clone"
+    private val registerPhone = "com.whatsapp.registration.app.phonenumberentry.RegisterPhone"
+    private val stringType = "Ljava/lang/String;"
+    private val componentInit = ImmutableMethodReference(
+        "Landroid/content/ComponentName;", "<init>", listOf(stringType, stringType), "V"
+    )
+
+    private fun dexOf(build: (DexBuilder) -> Unit): File {
+        val file = Files.createTempFile("openclone-fixture-", ".dex").toFile().also { it.deleteOnExit() }
+        val builder = DexBuilder(Opcodes.getDefault())
+        build(builder)
+        builder.writeTo(FileDataStore(file))
+        return file
+    }
+
+    private fun DexBuilder.addClass(type: String, methods: List<BuilderMethod>, fields: List<BuilderField> = emptyList()) =
+        internClassDef(type, AccessFlags.PUBLIC.value, "Ljava/lang/Object;", emptyList(), null, emptySet(), fields, methods)
+
+    private fun DexBuilder.addMethod(type: String, name: String, registers: Int, code: MutableMethodImplementation.() -> Unit) =
+        internMethod(
+            type, name, emptyList(), "V", AccessFlags.PUBLIC.value or AccessFlags.STATIC.value,
+            emptySet(), emptySet(), MutableMethodImplementation(registers).apply(code)
+        )
+
+    private fun MutableMethodImplementation.constString(b: DexBuilder, register: Int, value: String) =
+        addInstruction(BuilderInstruction21c(Opcode.CONST_STRING, register, b.internStringReference(value)))
+
+    private fun MutableMethodImplementation.newComponent(b: DexBuilder, package_: Int, class_: Int) =
+        addInstruction(BuilderInstruction35c(Opcode.INVOKE_DIRECT, 3, 2, package_, class_, 0, 0, b.internMethodReference(componentInit)))
+
+    private fun MutableMethodImplementation.finish() = addInstruction(BuilderInstruction10x(Opcode.RETURN_VOID))
+
+    private fun literalsOf(dex: File): List<String> {
+        val result = mutableListOf<String>()
+        for (classDef in DexFileFactory.loadDexFile(dex, Opcodes.getDefault()).classes) {
+            for (method in classDef.methods) {
+                method.implementation?.instructions?.forEach {
+                    ((it as? ReferenceInstruction)?.reference as? StringReference)?.let { ref -> result += ref.string }
+                }
+            }
+        }
+        return result
+    }
+
+    private fun staticFieldStrings(dex: File): List<String> {
+        val result = mutableListOf<String>()
+        for (classDef in DexFileFactory.loadDexFile(dex, Opcodes.getDefault()).classes) {
+            for (field in classDef.staticFields) {
+                (field.initialValue as? org.jf.dexlib2.iface.value.StringEncodedValue)?.let { result += it.value }
+            }
+        }
+        return result
+    }
+
+    private fun rewrite(input: File): Pair<File, DexPackageStringRewriter.Result> {
+        val output = Files.createTempFile("openclone-rewritten-", ".dex").toFile().also { it.deleteOnExit() }
+        return output to DexPackageStringRewriter.rewrite(input, output, old, clone)
+    }
+
+    @Test
+    fun separatePackageAndClassLiteralsTargetTheCloneAndKeepTheClass() {
+        val dex = dexOf { b ->
+            val m = b.addMethod("Lcom/whatsapp/Launcher;", "open", 3) {
+                constString(b, 0, old); constString(b, 1, registerPhone); newComponent(b, 0, 1); finish()
+            }
+            b.addClass("Lcom/whatsapp/Launcher;", listOf(m))
+        }
+        val (out, result) = rewrite(dex)
+        assertEquals(1, result.replacements)
+        assertEquals(listOf(clone, registerPhone), literalsOf(out))
+    }
+
+    @Test
+    fun flattenedComponentTargetsTheCloneWithTheFullyQualifiedOriginalClass() {
+        val dex = dexOf { b ->
+            val m = b.addMethod("Lcom/whatsapp/Launcher;", "open", 1) {
+                constString(b, 0, "com.whatsapp/.registration.app.phonenumberentry.RegisterPhone"); finish()
+            }
+            b.addClass("Lcom/whatsapp/Launcher;", listOf(m))
+        }
+        val (out, result) = rewrite(dex)
+        assertEquals(1, result.replacements)
+        assertEquals(listOf("$clone/$registerPhone"), literalsOf(out))
+    }
+
+    @Test
+    fun staticFieldStringValuesAreRewritten() {
+        val dex = dexOf { b ->
+            val f = b.internField("Lcom/whatsapp/Consts;", "PKG", stringType, AccessFlags.PUBLIC.value or AccessFlags.STATIC.value or AccessFlags.FINAL.value, ImmutableStringEncodedValue(old), emptySet(), emptySet())
+            b.addClass("Lcom/whatsapp/Consts;", emptyList(), listOf(f))
+        }
+        val (out, result) = rewrite(dex)
+        assertEquals(1, result.replacements)
+        assertEquals(listOf(clone), staticFieldStrings(out))
+    }
+
+    @Test
+    fun otherIdentifiersThatStartWithThePackageAreLeftAlone() {
+        val untouched = listOf("com.whatsapp.permission.BROADCAST", "com.whatsapp.provider.media", "com.whatsapp_preferences", registerPhone)
+        val dex = dexOf { b ->
+            val m = b.addMethod("Lcom/whatsapp/Names;", "all", 1) {
+                untouched.forEach { constString(b, 0, it) }; finish()
+            }
+            b.addClass("Lcom/whatsapp/Names;", listOf(m))
+        }
+        val (out, result) = rewrite(dex)
+        assertEquals(0, result.replacements)
+        assertEquals(untouched, literalsOf(out))
+    }
+
+    @Test
+    fun classAndMethodStructureIsPreserved() {
+        val dex = dexOf { b ->
+            val m = b.addMethod("Lcom/whatsapp/registration/app/phonenumberentry/RegisterPhone;", "run", 1) {
+                constString(b, 0, old); finish()
+            }
+            b.addClass("Lcom/whatsapp/registration/app/phonenumberentry/RegisterPhone;", listOf(m))
+        }
+        val (out, _) = rewrite(dex)
+        val loaded = DexFileFactory.loadDexFile(out, Opcodes.getDefault()).classes.toList()
+        assertEquals(listOf("Lcom/whatsapp/registration/app/phonenumberentry/RegisterPhone;"), loaded.map { it.type })
+        assertEquals(listOf("run"), loaded.single().methods.map { it.name })
+    }
+
+    @Test
+    fun scannerSeparatesFlattenedSeparateAndDynamicShapes() {
+        val dex = dexOf { b ->
+            val separate = b.addMethod("Lcom/whatsapp/A;", "separate", 3) {
+                constString(b, 0, old); constString(b, 1, registerPhone); newComponent(b, 0, 1); finish()
+            }
+            val flattened = b.addMethod("Lcom/whatsapp/A;", "flattened", 1) {
+                constString(b, 0, "com.whatsapp/.registration.app.phonenumberentry.RegisterPhone"); finish()
+            }
+            val dynamic = b.addMethod("Lcom/whatsapp/A;", "dynamic", 2) {
+                constString(b, 0, old); constString(b, 1, "/.registration.app.phonenumberentry.RegisterPhone"); finish()
+            }
+            b.addClass("Lcom/whatsapp/A;", listOf(separate, flattened, dynamic))
+        }
+        val byMethod = DexComponentScanner.scan(dex, old).associateBy { it.method.substringAfter("->") }
+        assertEquals(DexComponentScanner.Shape.SEPARATE_LITERALS, byMethod.getValue("separate").shape)
+        assertEquals(DexComponentScanner.Shape.FLATTENED, byMethod.getValue("flattened").shape)
+        assertEquals(DexComponentScanner.Shape.DYNAMIC, byMethod.getValue("dynamic").shape)
+        assertTrue("ComponentName-><init>" in byMethod.getValue("separate").componentApis)
+    }
+
+    /**
+     * Documents a known limit rather than hiding it: the exact package literal is rewritten but a
+     * separate relative fragment is not, so a class built as package + ".X" would resolve under the
+     * clone package. The scanner flags that shape so it is visible in a real app's DEX.
+     */
+    @Test
+    fun relativeFragmentBesideTheBarePackageIsFlaggedAsDynamic() {
+        val dex = dexOf { b ->
+            val m = b.addMethod("Lcom/whatsapp/B;", "build", 2) {
+                constString(b, 0, old); constString(b, 1, ".registration.X"); finish()
+            }
+            b.addClass("Lcom/whatsapp/B;", listOf(m))
+        }
+        val (out, _) = rewrite(dex)
+        assertEquals(listOf(clone, ".registration.X"), literalsOf(out))
+        assertFalse(DexComponentScanner.scan(dex, old).none { it.shape == DexComponentScanner.Shape.DYNAMIC })
+    }
+}
